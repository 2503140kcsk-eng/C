module

public import HakuiKoyori.LowLevelMacros

public section

/-!
# Primitive execution semantics for the concrete MUL template

This module executes the actual finite instruction list generated by
mulBlock, using AssistantMachine.step. The results are about primitive
target steps, rather than the abstract loop-header semantics in
MacroSemantics.lean.
-/

namespace HakuiKoyori
namespace Compiler

open AssistantMachine

/-- Execute exactly n primitive transitions, provided all exist. -/
def runN : Nat → Program → Configuration → Option Configuration
  | 0, _, configuration => some configuration
  | n + 1, program, configuration =>
      (AssistantMachine.step program configuration).bind (runN n program)

theorem runN_add (n m : Nat) (program : Program) (configuration : Configuration) :
    runN (n + m) program configuration =
      (runN n program configuration).bind
        (fun middle => runN m program middle) := by
  induction n generalizing configuration with
  | zero => simp [runN]
  | succ n ih =>
      cases hstep : AssistantMachine.step program configuration with
      | none => simp [runN, Nat.succ_add, hstep]
      | some middle => simp [runN, Nat.succ_add, hstep, ih]

/-- Materialize one symbolic MUL block as an M1 instruction list. -/
def concreteMUL (factor destination : Nat) : Program :=
  (mulBlock factor (.offset destination)).map
    (relocateInstruction [] 0)

theorem concreteMUL_eq (factor destination : Nat) :
    concreteMUL factor destination =
      [ .decJump .left 7
      , .decJump .right 4
      , .inc .left
      , .decJump .left destination
      , .inc .left
      , .inc .left
      , .decJump .left 1
      ] ++ List.replicate factor (.inc .right) ++
      [ .inc .right, .decJump .right 0 ] := by
  simp [concreteMUL, mulBlock, identityJump,
    relocateInstruction, resolveTarget]

theorem concreteMUL_entry_positive
    (factor destination data scratch : Nat) :
    AssistantMachine.step (concreteMUL factor destination)
      ⟨0, data + 1, scratch⟩ = some ⟨7, data, scratch⟩ := by
  rw [concreteMUL_eq]
  simp [AssistantMachine.step, AssistantMachine.readCounter,
    AssistantMachine.writeCounter, AssistantMachine.setPC]

theorem concreteMUL_entry_zero
    (factor destination scratch : Nat) :
    AssistantMachine.step (concreteMUL factor destination)
      ⟨0, 0, scratch⟩ = some ⟨1, 0, scratch⟩ := by
  rw [concreteMUL_eq]
  simp [AssistantMachine.step, AssistantMachine.readCounter,
    AssistantMachine.writeCounter, AssistantMachine.setPC]

theorem concreteMUL_replicate_step
    (factor destination i data scratch : Nat) (hi : i < factor) :
    AssistantMachine.step (concreteMUL factor destination)
      ⟨7 + i, data, scratch⟩ =
      some ⟨7 + i + 1, data, scratch + 1⟩ := by
  let prefix : Program :=
    [AssistantMachine.Instruction.decJump .left 7,
     AssistantMachine.Instruction.decJump .right 4,
     AssistantMachine.Instruction.inc .left,
     AssistantMachine.Instruction.decJump .left destination,
     AssistantMachine.Instruction.inc .left,
     AssistantMachine.Instruction.inc .left,
     AssistantMachine.Instruction.decJump .left 1]
  have hget :
      (concreteMUL factor destination)[7 + i]? =
        some (.inc .right) := by
    rw [concreteMUL_eq, List.append_assoc]
    change (prefix ++
      (List.replicate factor (AssistantMachine.Instruction.inc .right) ++
        [AssistantMachine.Instruction.inc .right,
         AssistantMachine.Instruction.decJump .right 0]))[7 + i]? =
        some (AssistantMachine.Instruction.inc .right)
    rw [List.getElem?_append_right (l₁ := prefix) (i := 7 + i)
      (by simp [prefix])]
    rw [show 7 + i - prefix.length = i by simp [prefix]]
    rw [List.getElem?_append_left
      (l₁ := List.replicate factor (AssistantMachine.Instruction.inc .right))
      (i := i) hi]
    exact List.getElem?_replicate_of_lt hi
  simp [AssistantMachine.step, hget, AssistantMachine.readCounter,
    AssistantMachine.writeCounter, AssistantMachine.setPC]

theorem concreteMUL_identity_first
    (factor destination data scratch : Nat) :
    AssistantMachine.step (concreteMUL factor destination)
      ⟨7 + factor, data, scratch⟩ =
      some ⟨8 + factor, data, scratch + 1⟩ := by
  let prefix : Program :=
    [AssistantMachine.Instruction.decJump .left 7,
     AssistantMachine.Instruction.decJump .right 4,
     AssistantMachine.Instruction.inc .left,
     AssistantMachine.Instruction.decJump .left destination,
     AssistantMachine.Instruction.inc .left,
     AssistantMachine.Instruction.inc .left,
     AssistantMachine.Instruction.decJump .left 1]
  have hget :
      (concreteMUL factor destination)[7 + factor]? =
        some (.inc .right) := by
    rw [concreteMUL_eq, List.append_assoc]
    change (prefix ++
      (List.replicate factor (AssistantMachine.Instruction.inc .right) ++
        [AssistantMachine.Instruction.inc .right,
         AssistantMachine.Instruction.decJump .right 0]))[7 + factor]? =
        some (AssistantMachine.Instruction.inc .right)
    rw [List.getElem?_append_right (l₁ := prefix) (i := 7 + factor)
      (by simp [prefix])]
    rw [show 7 + factor - prefix.length = factor by simp [prefix]]
    rw [List.getElem?_append_right
      (l₁ := List.replicate factor (AssistantMachine.Instruction.inc .right))
      (i := factor) (by simp)]
    rw [Nat.sub_self]
    rfl
  simp [AssistantMachine.step, hget, AssistantMachine.readCounter,
    AssistantMachine.writeCounter, AssistantMachine.setPC]
  omega

theorem concreteMUL_identity_second
    (factor destination data scratch : Nat) :
    AssistantMachine.step (concreteMUL factor destination)
      ⟨8 + factor, data, scratch + 1⟩ =
      some ⟨0, data, scratch⟩ := by
  let prefix : Program :=
    [AssistantMachine.Instruction.decJump .left 7,
     AssistantMachine.Instruction.decJump .right 4,
     AssistantMachine.Instruction.inc .left,
     AssistantMachine.Instruction.decJump .left destination,
     AssistantMachine.Instruction.inc .left,
     AssistantMachine.Instruction.inc .left,
     AssistantMachine.Instruction.decJump .left 1]
  have hget :
      (concreteMUL factor destination)[8 + factor]? =
        some (.decJump .right 0) := by
    rw [concreteMUL_eq, List.append_assoc]
    change (prefix ++
      (List.replicate factor (AssistantMachine.Instruction.inc .right) ++
        [AssistantMachine.Instruction.inc .right,
         AssistantMachine.Instruction.decJump .right 0]))[8 + factor]? =
        some (AssistantMachine.Instruction.decJump .right 0)
    rw [List.getElem?_append_right (l₁ := prefix) (i := 8 + factor)
      (by omega)]
    rw [show 8 + factor - prefix.length = factor + 1 by simp [prefix] <;> omega]
    rw [List.getElem?_append_right
      (l₁ := List.replicate factor (AssistantMachine.Instruction.inc .right))
      (i := factor + 1) (by omega)]
    rw [show factor + 1 - factor = 1 by omega]
    rfl
  simp [AssistantMachine.step, hget, AssistantMachine.readCounter,
    AssistantMachine.writeCounter, AssistantMachine.setPC]

theorem concreteMUL_replicate_run
    (factor destination i fuel data scratch : Nat)
    (hbound : i + fuel ≤ factor) :
    runN fuel (concreteMUL factor destination)
      ⟨7 + i, data, scratch⟩ =
      some ⟨7 + i + fuel, data, scratch + fuel⟩ := by
  induction fuel generalizing i data scratch with
  | zero => simp [runN]
  | succ fuel ih =>
      have hi : i < factor := by omega
      have hrest : (i + 1) + fuel ≤ factor := by omega
      simp only [runN]
      rw [concreteMUL_replicate_step factor destination i data scratch hi]
      simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
        ih (i + 1) data (scratch + 1) hrest

theorem concreteMUL_outer_round
    (factor destination data scratch : Nat) :
    runN (factor + 3) (concreteMUL factor destination)
      ⟨0, data + 1, scratch⟩ =
      some ⟨0, data, scratch + factor⟩ := by
  have hfirst :
      runN 1 (concreteMUL factor destination)
        ⟨0, data + 1, scratch⟩ = some ⟨7, data, scratch⟩ := by
    simp [runN, concreteMUL_entry_positive]
  have hbody :
      runN factor (concreteMUL factor destination)
        ⟨7, data, scratch⟩ =
      some ⟨7 + factor, data, scratch + factor⟩ := by
    simpa using concreteMUL_replicate_run factor destination 0 factor data scratch
      (by omega)
  have htail :
      runN 2 (concreteMUL factor destination)
        ⟨7 + factor, data, scratch + factor⟩ =
      some ⟨0, data, scratch + factor⟩ := by
    simp [runN, concreteMUL_identity_first, concreteMUL_identity_second]
  calc
    runN (factor + 3) (concreteMUL factor destination)
        ⟨0, data + 1, scratch⟩ =
      runN (1 + (factor + 2)) (concreteMUL factor destination)
        ⟨0, data + 1, scratch⟩ := by congr 1 <;> omega
    _ = (runN 1 (concreteMUL factor destination)
          ⟨0, data + 1, scratch⟩).bind
          (fun middle => runN (factor + 2)
            (concreteMUL factor destination) middle) :=
        runN_add 1 (factor + 2) _ _
    _ = runN (factor + 2) (concreteMUL factor destination)
          ⟨7, data, scratch⟩ := by simp [hfirst]
    _ = (runN factor (concreteMUL factor destination)
          ⟨7, data, scratch⟩).bind
          (fun middle => runN 2 (concreteMUL factor destination) middle) :=
        runN_add factor 2 _ _
    _ = some ⟨0, data, scratch + factor⟩ := by simp [hbody, htail]

theorem concreteMUL_outer_loop
    (factor destination input scratch : Nat) :
    runN (input * (factor + 3)) (concreteMUL factor destination)
      ⟨0, input, scratch⟩ =
      some ⟨0, 0, scratch + factor * input⟩ := by
  induction input generalizing scratch with
  | zero => simp [runN]
  | succ input ih =>
      have hround := concreteMUL_outer_round factor destination input scratch
      have hrest := ih (scratch + factor)
      have hcount :
          (input + 1) * (factor + 3) =
            (factor + 3) + input * (factor + 3) := by ring
      calc
        runN ((input + 1) * (factor + 3)) (concreteMUL factor destination)
            ⟨0, input + 1, scratch⟩ =
          (runN (factor + 3) (concreteMUL factor destination)
              ⟨0, input + 1, scratch⟩).bind
            (fun middle => runN (input * (factor + 3))
              (concreteMUL factor destination) middle) := by
                rw [hcount]
                exact runN_add (factor + 3) (input * (factor + 3))
                  (concreteMUL factor destination) ⟨0, input + 1, scratch⟩
        _ = runN (input * (factor + 3)) (concreteMUL factor destination)
              ⟨0, input, scratch + factor⟩ := by simp [hround]
        _ = some ⟨0, 0, scratch + factor + factor * input⟩ := hrest
        _ = some ⟨0, 0, scratch + factor * (input + 1)⟩ := by
              congr 2 <;> ring

theorem concreteMUL_transfer_test
    (factor destination data scratch : Nat) :
    AssistantMachine.step (concreteMUL factor destination)
      ⟨1, data, scratch + 1⟩ = some ⟨4, data, scratch⟩ := by
  rw [concreteMUL_eq]
  simp [AssistantMachine.step, AssistantMachine.readCounter,
    AssistantMachine.writeCounter, AssistantMachine.setPC]

theorem concreteMUL_transfer_inc1
    (factor destination data scratch : Nat) :
    AssistantMachine.step (concreteMUL factor destination)
      ⟨4, data, scratch⟩ = some ⟨5, data + 1, scratch⟩ := by
  rw [concreteMUL_eq]
  simp [AssistantMachine.step, AssistantMachine.readCounter,
    AssistantMachine.writeCounter, AssistantMachine.setPC]

theorem concreteMUL_transfer_inc2
    (factor destination data scratch : Nat) :
    AssistantMachine.step (concreteMUL factor destination)
      ⟨5, data + 1, scratch⟩ = some ⟨6, data + 2, scratch⟩ := by
  rw [concreteMUL_eq]
  simp [AssistantMachine.step, AssistantMachine.readCounter,
    AssistantMachine.writeCounter, AssistantMachine.setPC]

theorem concreteMUL_transfer_back
    (factor destination data scratch : Nat) :
    AssistantMachine.step (concreteMUL factor destination)
      ⟨6, data + 2, scratch⟩ = some ⟨1, data + 1, scratch⟩ := by
  rw [concreteMUL_eq]
  simp [AssistantMachine.step, AssistantMachine.readCounter,
    AssistantMachine.writeCounter, AssistantMachine.setPC]

theorem concreteMUL_transfer_round
    (factor destination data scratch : Nat) :
    runN 4 (concreteMUL factor destination)
      ⟨1, data, scratch + 1⟩ =
      some ⟨1, data + 1, scratch⟩ := by
  simp [runN, concreteMUL_transfer_test, concreteMUL_transfer_inc1,
    concreteMUL_transfer_inc2, concreteMUL_transfer_back]

theorem concreteMUL_transfer_loop
    (factor destination data scratch : Nat) :
    runN (4 * scratch) (concreteMUL factor destination)
      ⟨1, data, scratch⟩ =
      some ⟨1, data + scratch, 0⟩ := by
  induction scratch generalizing data with
  | zero => simp [runN]
  | succ scratch ih =>
      have hround := concreteMUL_transfer_round factor destination data scratch
      have hrest := ih (data + 1)
      have hcount : 4 * (scratch + 1) = 4 + 4 * scratch := by omega
      calc
        runN (4 * (scratch + 1)) (concreteMUL factor destination)
            ⟨1, data, scratch + 1⟩ =
          (runN 4 (concreteMUL factor destination)
              ⟨1, data, scratch + 1⟩).bind
            (fun middle => runN (4 * scratch)
              (concreteMUL factor destination) middle) := by
                rw [hcount]
                exact runN_add 4 (4 * scratch) (concreteMUL factor destination)
                  ⟨1, data, scratch + 1⟩
        _ = runN (4 * scratch) (concreteMUL factor destination)
              ⟨1, data + 1, scratch⟩ := by simp [hround]
        _ = some ⟨1, data + 1 + scratch, 0⟩ := hrest
        _ = some ⟨1, data + (scratch + 1), 0⟩ := by
              congr 2 <;> omega

theorem concreteMUL_exit_zero
    (factor destination data : Nat) :
    AssistantMachine.step (concreteMUL factor destination)
      ⟨1, data, 0⟩ = some ⟨2, data, 0⟩ := by
  rw [concreteMUL_eq]
  simp [AssistantMachine.step, AssistantMachine.readCounter,
    AssistantMachine.writeCounter, AssistantMachine.setPC]

theorem concreteMUL_exit
    (factor destination data : Nat) :
    runN 3 (concreteMUL factor destination)
      ⟨1, data, 0⟩ = some ⟨destination, data, 0⟩ := by
  simp [runN, concreteMUL_exit_zero, AssistantMachine.step,
    AssistantMachine.readCounter, AssistantMachine.writeCounter,
    AssistantMachine.setPC, concreteMUL_eq]

/-- All-input primitive correctness of the literal generated MUL block. -/
theorem concreteMUL_correct_run
    (factor destination input : Nat) :
    runN (input * (5 * factor + 3) + 4)
      (concreteMUL factor destination) ⟨0, input, 0⟩ =
      some ⟨destination, factor * input, 0⟩ := by
  have houter := concreteMUL_outer_loop factor destination input 0
  have hzero :
      runN 1 (concreteMUL factor destination)
        ⟨0, 0, factor * input⟩ =
        some ⟨1, 0, factor * input⟩ := by
    simp [runN, concreteMUL_entry_zero]
  have htransfer :=
    concreteMUL_transfer_loop factor destination 0 (factor * input)
  have hexit := concreteMUL_exit factor destination (factor * input)
  have hcount :
      input * (5 * factor + 3) + 4 =
        input * (factor + 3) + (1 + (4 * (factor * input) + 3)) := by ring
  calc
    runN (input * (5 * factor + 3) + 4)
        (concreteMUL factor destination) ⟨0, input, 0⟩ =
      (runN (input * (factor + 3)) (concreteMUL factor destination)
          ⟨0, input, 0⟩).bind
        (fun middle => runN (1 + (4 * (factor * input) + 3))
          (concreteMUL factor destination) middle) := by
            rw [hcount]
            exact runN_add (input * (factor + 3))
              (1 + (4 * (factor * input) + 3))
              (concreteMUL factor destination) ⟨0, input, 0⟩
    _ = runN (1 + (4 * (factor * input) + 3))
          (concreteMUL factor destination) ⟨0, 0, factor * input⟩ := by
            simp [houter]
    _ = (runN 1 (concreteMUL factor destination)
          ⟨0, 0, factor * input⟩).bind
          (fun middle => runN (4 * (factor * input) + 3)
            (concreteMUL factor destination) middle) := by
            exact runN_add 1 (4 * (factor * input) + 3)
              (concreteMUL factor destination) ⟨0, 0, factor * input⟩
    _ = runN (4 * (factor * input) + 3)
          (concreteMUL factor destination) ⟨1, 0, factor * input⟩ := by
            simp [hzero]
    _ = (runN (4 * (factor * input)) (concreteMUL factor destination)
          ⟨1, 0, factor * input⟩).bind
          (fun middle => runN 3 (concreteMUL factor destination) middle) := by
            exact runN_add (4 * (factor * input)) 3
              (concreteMUL factor destination) ⟨1, 0, factor * input⟩
    _ = some ⟨destination, factor * input, 0⟩ := by
            simp [htransfer, hexit]

end Compiler
end HakuiKoyori
