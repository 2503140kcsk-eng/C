module

public import HakuiKoyori.LowLevelMacros

public section

/-!
# Primitive execution semantics for the concrete MUL template

This module executes the actual finite instruction list generated by
mulBlock, using AssistantMachine.step. The results are about primitive
target steps, rather than the abstract loop-header semantics in
MacroSemantics.lean.
-/

namespace HakuiKoyori
namespace Compiler

open AssistantMachine

/-- Execute exactly n primitive transitions, provided all exist. -/
def runN : Nat → Program → Configuration → Option Configuration
  | 0, _, configuration => some configuration
  | n + 1, program, configuration =>
      (AssistantMachine.step program configuration).bind (runN n program)

theorem runN_add (n m : Nat) (program : Program) (configuration : Configuration) :
    runN (n + m) program configuration =
      (runN n program configuration).bind
        (fun middle => runN m program middle) := by
  induction n generalizing configuration with
  | zero => simp [runN]
  | succ n ih =>
      cases hstep : AssistantMachine.step program configuration with
      | none => simp [runN, Nat.succ_add, hstep]
      | some middle => simp [runN, Nat.succ_add, hstep, ih]

/-- Materialize one symbolic MUL block as an M1 instruction list. -/
def concreteMUL (factor destination : Nat) : Program :=
  (mulBlock factor (.offset destination)).map
    (relocateInstruction [] 0)

theorem concreteMUL_eq (factor destination : Nat) :
    concreteMUL factor destination =
      [ .decJump .left 7
      , .decJump .right 4
      , .inc .left
      , .decJump .left destination
      , .inc .left
      , .inc .left
      , .decJump .left 1
      ] ++ List.replicate factor (.inc .right) ++
      [ .inc .right, .decJump .right 0 ] := by
  simp [concreteMUL, mulBlock, identityJump,
    relocateInstruction, resolveTarget]

theorem concreteMUL_entry_positive
    (factor destination data scratch : Nat) :
    AssistantMachine.step (concreteMUL factor destination)
      ⟨0, data + 1, scratch⟩ = some ⟨7, data, scratch⟩ := by
  rw [concreteMUL_eq]
  simp [AssistantMachine.step, AssistantMachine.readCounter,
    AssistantMachine.writeCounter, AssistantMachine.setPC]

theorem concreteMUL_entry_zero
    (factor destination scratch : Nat) :
    AssistantMachine.step (concreteMUL factor destination)
      ⟨0, 0, scratch⟩ = some ⟨1, 0, scratch⟩ := by
  rw [concreteMUL_eq]
  simp [AssistantMachine.step, AssistantMachine.readCounter,
    AssistantMachine.writeCounter, AssistantMachine.setPC]

theorem concreteMUL_replicate_step
    (factor destination i data scratch : Nat) (hi : i < factor) :
    AssistantMachine.step (concreteMUL factor destination)
      ⟨7 + i, data, scratch⟩ =
      some ⟨7 + i + 1, data, scratch + 1⟩ := by
  let mulPrefix : Program :=
    [AssistantMachine.Instruction.decJump .left 7,
     AssistantMachine.Instruction.decJump .right 4,
     AssistantMachine.Instruction.inc .left,
     AssistantMachine.Instruction.decJump .left destination,
     AssistantMachine.Instruction.inc .left,
     AssistantMachine.Instruction.inc .left,
     AssistantMachine.Instruction.decJump .left 1]
  have hget :
      (concreteMUL factor destination)[7 + i]? =
        some (.inc .right) := by
    rw [concreteMUL_eq, List.append_assoc]
    change (mulPrefix ++
      (List.replicate factor (AssistantMachine.Instruction.inc .right) ++
        [AssistantMachine.Instruction.inc .right,
         AssistantMachine.Instruction.decJump .right 0]))[7 + i]? =
        some (AssistantMachine.Instruction.inc .right)
    rw [List.getElem?_append_right (l₁ := mulPrefix) (i := 7 + i)
      (by change 7 ≤ 7 + i; omega)]
    rw [show 7 + i - mulPrefix.length = i by
      change 7 + i - 7 = i
      omega]
    rw [List.getElem?_append_left
      (l₁ := List.replicate factor (AssistantMachine.Instruction.inc .right))
      (i := i) (by simpa using hi)]
    exact List.getElem?_replicate_of_lt hi
  simp [AssistantMachine.step, hget, AssistantMachine.readCounter,
    AssistantMachine.writeCounter, AssistantMachine.setPC]

theorem concreteMUL_identity_first
    (factor destination data scratch : Nat) :
    AssistantMachine.step (concreteMUL factor destination)
      ⟨7 + factor, data, scratch⟩ =
      some ⟨8 + factor, data, scratch + 1⟩ := by
  let mulPrefix : Program :=
    [AssistantMachine.Instruction.decJump .left 7,
     AssistantMachine.Instruction.decJump .right 4,
     AssistantMachine.Instruction.inc .left,
     AssistantMachine.Instruction.decJump .left destination,
     AssistantMachine.Instruction.inc .left,
     AssistantMachine.Instruction.inc .left,
     AssistantMachine.Instruction.decJump .left 1]
  have hget :
      (concreteMUL factor destination)[7 + factor]? =
        some (.inc .right) := by
    rw [concreteMUL_eq, List.append_assoc]
    change (mulPrefix ++
      (List.replicate factor (AssistantMachine.Instruction.inc .right) ++
        [AssistantMachine.Instruction.inc .right,
         AssistantMachine.Instruction.decJump .right 0]))[7 + factor]? =
        some (AssistantMachine.Instruction.inc .right)
    rw [List.getElem?_append_right (l₁ := mulPrefix) (i := 7 + factor)
      (by change 7 ≤ 7 + factor; omega)]
    rw [show 7 + factor - mulPrefix.length = factor by
      change 7 + factor - 7 = factor
      omega]
    rw [List.getElem?_append_right
      (l₁ := List.replicate factor (AssistantMachine.Instruction.inc .right))
      (i := factor) (by simp)]
    simp
  simp [AssistantMachine.step, hget, AssistantMachine.readCounter,
    AssistantMachine.writeCounter, AssistantMachine.setPC]
  omega

theorem concreteMUL_identity_second
    (factor destination data scratch : Nat) :
    AssistantMachine.step (concreteMUL factor destination)
      ⟨8 + factor, data, scratch + 1⟩ =
      some ⟨0, data, scratch⟩ := by
  let mulPrefix : Program :=
    [AssistantMachine.Instruction.decJump .left 7,
     AssistantMachine.Instruction.decJump .right 4,
     AssistantMachine.Instruction.inc .left,
     AssistantMachine.Instruction.decJump .left destination,
     AssistantMachine.Instruction.inc .left,
     AssistantMachine.Instruction.inc .left,
     AssistantMachine.Instruction.decJump .left 1]
  have hget :
      (concreteMUL factor destination)[8 + factor]? =
        some (.decJump .right 0) := by
    rw [concreteMUL_eq, List.append_assoc]
    change (mulPrefix ++
      (List.replicate factor (AssistantMachine.Instruction.inc .right) ++
        [AssistantMachine.Instruction.inc .right,
         AssistantMachine.Instruction.decJump .right 0]))[8 + factor]? =
        some (AssistantMachine.Instruction.decJump .right 0)
    rw [List.getElem?_append_right (l₁ := mulPrefix) (i := 8 + factor)
      (by change 7 ≤ 8 + factor; omega)]
    rw [show 8 + factor - mulPrefix.length = factor + 1 by
      change 8 + factor - 7 = factor + 1
      omega]
    rw [List.getElem?_append_right
      (l₁ := List.replicate factor (AssistantMachine.Instruction.inc .right))
      (i := factor + 1) (by simp)]
    simp
  simp [AssistantMachine.step, hget, AssistantMachine.readCounter,
    AssistantMachine.writeCounter, AssistantMachine.setPC]

theorem concreteMUL_replicate_run
    (factor destination i fuel data scratch : Nat)
    (hbound : i + fuel ≤ factor) :
    runN fuel (concreteMUL factor destination)
      ⟨7 + i, data, scratch⟩ =
      some ⟨7 + i + fuel, data, scratch + fuel⟩ := by
  induction fuel generalizing i data scratch with
  | zero => simp [runN]
  | succ fuel ih =>
      have hi : i < factor := by omega
      have hrest : (i + 1) + fuel ≤ factor := by omega
      simp only [runN]
      rw [concreteMUL_replicate_step factor destination i data scratch hi]
      simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
        ih (i + 1) data (scratch + 1) hrest

theorem concreteMUL_outer_round
    (factor destination data scratch : Nat) :
    runN (factor + 3) (concreteMUL factor destination)
      ⟨0, data + 1, scratch⟩ =
      some ⟨0, data, scratch + factor⟩ := by
  have hfirst :
      runN 1 (concreteMUL factor destination)
        ⟨0, data + 1, scratch⟩ = some ⟨7, data, scratch⟩ := by
    simp [runN, concreteMUL_entry_positive]
  have hbody :
      runN factor (concreteMUL factor destination)
        ⟨7, data, scratch⟩ =
      some ⟨7 + factor, data, scratch + factor⟩ := by
    simpa using concreteMUL_replicate_run factor destination 0 factor data scratch
      (by omega)
  have htail :
      runN 2 (concreteMUL factor destination)
        ⟨7 + factor, data, scratch + factor⟩ =
      some ⟨0, data, scratch + factor⟩ := by
    simp [runN, concreteMUL_identity_first, concreteMUL_identity_second]
  calc
    runN (factor + 3) (concreteMUL factor destination)
        ⟨0, data + 1, scratch⟩ =
      runN (1 + (factor + 2)) (concreteMUL factor destination)
        ⟨0, data + 1, scratch⟩ := by congr 1 <;> omega
    _ = (runN 1 (concreteMUL factor destination)
          ⟨0, data + 1, scratch⟩).bind
          (fun middle => runN (factor + 2)
            (concreteMUL factor destination) middle) :=
        runN_add 1 (factor + 2) _ _
    _ = runN (factor + 2) (concreteMUL factor destination)
          ⟨7, data, scratch⟩ := by simp [hfirst]
    _ = (runN factor (concreteMUL factor destination)
          ⟨7, data, scratch⟩).bind
          (fun middle => runN 2 (concreteMUL factor destination) middle) :=
        runN_add factor 2 _ _
    _ = some ⟨0, data, scratch + factor⟩ := by simp [hbody, htail]

theorem concreteMUL_outer_loop
    (factor destination input scratch : Nat) :
    runN (input * (factor + 3)) (concreteMUL factor destination)
      ⟨0, input, scratch⟩ =
      some ⟨0, 0, scratch + factor * input⟩ := by
  induction input generalizing scratch with
  | zero => simp [runN]
  | succ input ih =>
      have hround := concreteMUL_outer_round factor destination input scratch
      have hrest := ih (scratch + factor)
      have hcount :
          (input + 1) * (factor + 3) =
            (factor + 3) + input * (factor + 3) := by ring
      calc
        runN ((input + 1) * (factor + 3)) (concreteMUL factor destination)
            ⟨0, input + 1, scratch⟩ =
          (runN (factor + 3) (concreteMUL factor destination)
              ⟨0, input + 1, scratch⟩).bind
            (fun middle => runN (input * (factor + 3))
              (concreteMUL factor destination) middle) := by
                rw [hcount]
                exact runN_add (factor + 3) (input * (factor + 3))
                  (concreteMUL factor destination) ⟨0, input + 1, scratch⟩
        _ = runN (input * (factor + 3)) (concreteMUL factor destination)
              ⟨0, input, scratch + factor⟩ := by simp [hround]
        _ = some ⟨0, 0, scratch + factor + factor * input⟩ := hrest
        _ = some ⟨0, 0, scratch + factor * (input + 1)⟩ := by
              congr 2 <;> ring

theorem concreteMUL_transfer_test
    (factor destination data scratch : Nat) :
    AssistantMachine.step (concreteMUL factor destination)
      ⟨1, data, scratch + 1⟩ = some ⟨4, data, scratch⟩ := by
  rw [concreteMUL_eq]
  simp [AssistantMachine.step, AssistantMachine.readCounter,
    AssistantMachine.writeCounter, AssistantMachine.setPC]

theorem concreteMUL_transfer_inc1
    (factor destination data scratch : Nat) :
    AssistantMachine.step (concreteMUL factor destination)
      ⟨4, data, scratch⟩ = some ⟨5, data + 1, scratch⟩ := by
  rw [concreteMUL_eq]
  simp [AssistantMachine.step, AssistantMachine.readCounter,
    AssistantMachine.writeCounter, AssistantMachine.setPC]

theorem concreteMUL_transfer_inc2
    (factor destination data scratch : Nat) :
    AssistantMachine.step (concreteMUL factor destination)
      ⟨5, data + 1, scratch⟩ = some ⟨6, data + 2, scratch⟩ := by
  rw [concreteMUL_eq]
  simp [AssistantMachine.step, AssistantMachine.readCounter,
    AssistantMachine.writeCounter, AssistantMachine.setPC]

theorem concreteMUL_transfer_back
    (factor destination data scratch : Nat) :
    AssistantMachine.step (concreteMUL factor destination)
      ⟨6, data + 2, scratch⟩ = some ⟨1, data + 1, scratch⟩ := by
  rw [concreteMUL_eq]
  simp [AssistantMachine.step, AssistantMachine.readCounter,
    AssistantMachine.writeCounter, AssistantMachine.setPC]

theorem concreteMUL_transfer_round
    (factor destination data scratch : Nat) :
    runN 4 (concreteMUL factor destination)
      ⟨1, data, scratch + 1⟩ =
      some ⟨1, data + 1, scratch⟩ := by
  simp [runN, concreteMUL_transfer_test, concreteMUL_transfer_inc1,
    concreteMUL_transfer_inc2, concreteMUL_transfer_back]

theorem concreteMUL_transfer_loop
    (factor destination data scratch : Nat) :
    runN (4 * scratch) (concreteMUL factor destination)
      ⟨1, data, scratch⟩ =
      some ⟨1, data + scratch, 0⟩ := by
  induction scratch generalizing data with
  | zero => simp [runN]
  | succ scratch ih =>
      have hround := concreteMUL_transfer_round factor destination data scratch
      have hrest := ih (data + 1)
      have hcount : 4 * (scratch + 1) = 4 + 4 * scratch := by omega
      calc
        runN (4 * (scratch + 1)) (concreteMUL factor destination)
            ⟨1, data, scratch + 1⟩ =
          (runN 4 (concreteMUL factor destination)
              ⟨1, data, scratch + 1⟩).bind
            (fun middle => runN (4 * scratch)
              (concreteMUL factor destination) middle) := by
                rw [hcount]
                exact runN_add 4 (4 * scratch) (concreteMUL factor destination)
                  ⟨1, data, scratch + 1⟩
        _ = runN (4 * scratch) (concreteMUL factor destination)
              ⟨1, data + 1, scratch⟩ := by simp [hround]
        _ = some ⟨1, data + 1 + scratch, 0⟩ := hrest
        _ = some ⟨1, data + (scratch + 1), 0⟩ := by
              congr 2 <;> omega

theorem concreteMUL_exit_zero
    (factor destination data : Nat) :
    AssistantMachine.step (concreteMUL factor destination)
      ⟨1, data, 0⟩ = some ⟨2, data, 0⟩ := by
  rw [concreteMUL_eq]
  simp [AssistantMachine.step, AssistantMachine.readCounter,
    AssistantMachine.writeCounter, AssistantMachine.setPC]

theorem concreteMUL_exit
    (factor destination data : Nat) :
    runN 3 (concreteMUL factor destination)
      ⟨1, data, 0⟩ = some ⟨destination, data, 0⟩ := by
  simp [runN, concreteMUL_exit_zero, AssistantMachine.step,
    AssistantMachine.readCounter, AssistantMachine.writeCounter,
    AssistantMachine.setPC, concreteMUL_eq]

/-- All-input primitive correctness of the literal generated MUL block. -/
theorem concreteMUL_correct_run
    (factor destination input : Nat) :
    runN (input * (5 * factor + 3) + 4)
      (concreteMUL factor destination) ⟨0, input, 0⟩ =
      some ⟨destination, factor * input, 0⟩ := by
  have houter := concreteMUL_outer_loop factor destination input 0
  have hzero :
      runN 1 (concreteMUL factor destination)
        ⟨0, 0, factor * input⟩ =
        some ⟨1, 0, factor * input⟩ := by
    simp [runN, concreteMUL_entry_zero]
  have htransfer :=
    concreteMUL_transfer_loop factor destination 0 (factor * input)
  have hexit := concreteMUL_exit factor destination (factor * input)
  have hcount :
      input * (5 * factor + 3) + 4 =
        input * (factor + 3) + (1 + (4 * (factor * input) + 3)) := by ring
  calc
    runN (input * (5 * factor + 3) + 4)
        (concreteMUL factor destination) ⟨0, input, 0⟩ =
      (runN (input * (factor + 3)) (concreteMUL factor destination)
          ⟨0, input, 0⟩).bind
        (fun middle => runN (1 + (4 * (factor * input) + 3))
          (concreteMUL factor destination) middle) := by
            rw [hcount]
            exact runN_add (input * (factor + 3))
              (1 + (4 * (factor * input) + 3))
              (concreteMUL factor destination) ⟨0, input, 0⟩
    _ = runN (1 + (4 * (factor * input) + 3))
          (concreteMUL factor destination) ⟨0, 0, factor * input⟩ := by
            simp [houter]
    _ = (runN 1 (concreteMUL factor destination)
          ⟨0, 0, factor * input⟩).bind
          (fun middle => runN (4 * (factor * input) + 3)
            (concreteMUL factor destination) middle) := by
            exact runN_add 1 (4 * (factor * input) + 3)
              (concreteMUL factor destination) ⟨0, 0, factor * input⟩
    _ = runN (4 * (factor * input) + 3)
          (concreteMUL factor destination) ⟨1, 0, factor * input⟩ := by
            simp [hzero]
    _ = (runN (4 * (factor * input)) (concreteMUL factor destination)
          ⟨1, 0, factor * input⟩).bind
          (fun middle => runN 3 (concreteMUL factor destination) middle) := by
            exact runN_add (4 * (factor * input)) 3
              (concreteMUL factor destination) ⟨1, 0, factor * input⟩
    _ = some ⟨destination, factor * input, 0⟩ := by
            simp [htransfer, hexit]



/-!
## Concrete execution of the emitted TR block

Unlike the abstract TR theorem in MacroSemantics, the following lemmas execute
the literal transferBlock list with AssistantMachine.step. The exact cost is
q*(m+3)+r+3, and the scratch counter is zero at the exit.
-/

/-- The zero-branch header and its fixed remainder handler. -/
def trHead (r destination : Nat) : Program :=
  [Instruction.decJump .right (3 + r)] ++
    (List.replicate r (Instruction.inc .left) ++
      [Instruction.inc .left, Instruction.decJump .left destination])

/-- The positive-branch multiplication body and its back-edge. -/
def trTail (m : Nat) : Program :=
  List.replicate m (Instruction.inc .left) ++
    [Instruction.inc .left, Instruction.decJump .left 0]

/-- The concrete program emitted from transferBlock with absolute local labels. -/
def concreteTR (m r destination : Nat) : Program :=
  trHead r destination ++ trTail m

/-- This is exactly the emitted LowLevelMacros.transferBlock, not a second ISA. -/
theorem concreteTR_eq_emitted (m r destination : Nat) :
    concreteTR m r destination =
      (transferBlock m r (.offset destination)).map
        (relocateInstruction [] 0) := by
  simp [concreteTR, trHead, trTail, transferBlock, identityJump,
    relocateInstruction, resolveTarget, List.append_assoc]

/-- The first TR region has exactly r+3 instructions. -/
theorem trHead_length (r destination : Nat) :
    (trHead r destination).length = r + 3 := by
  simp [trHead]
  omega

/-- The TR multiplication body contains exactly m increments. -/
theorem trTail_replicate_length (m : Nat) :
    (List.replicate m (Instruction.inc .left)).length = m := by
  simp

/-- A positive iteration's first instruction decrements B and enters the m-body. -/
theorem concreteTR_positive_test
    (m r destination a b : Nat) :
    AssistantMachine.step (concreteTR m r destination)
      ⟨0, a, b + 1⟩ = some ⟨r + 3, a, b⟩ := by
  simp [AssistantMachine.step, concreteTR, trHead, trTail,
    AssistantMachine.readCounter, AssistantMachine.writeCounter,
    AssistantMachine.setPC]

/-- The zero branch enters the remainder handler without changing either counter. -/
theorem concreteTR_zero_test
    (m r destination a : Nat) :
    AssistantMachine.step (concreteTR m r destination)
      ⟨0, a, 0⟩ = some ⟨1, a, 0⟩ := by
  simp [AssistantMachine.step, concreteTR, trHead, trTail,
    AssistantMachine.readCounter, AssistantMachine.writeCounter,
    AssistantMachine.setPC]

/-- Every instruction in the literal TR m-body increments A by one. -/
theorem concreteTR_body_step
    (m r destination i a b : Nat) (hi : i < m) :
    AssistantMachine.step (concreteTR m r destination)
      ⟨r + 3 + i, a, b⟩ =
      some ⟨r + 3 + i + 1, a + 1, b⟩ := by
  have hhead : (trHead r destination).length = r + 3 :=
    trHead_length r destination
  have htail : (List.replicate m (Instruction.inc .left)).length = m := by simp
  have hget :
      (concreteTR m r destination)[r + 3 + i]? =
        some (Instruction.inc .left) := by
    change (trHead r destination ++
      (List.replicate m (Instruction.inc .left) ++
        [Instruction.inc .left, Instruction.decJump .left 0]))[r + 3 + i]? =
        some (Instruction.inc .left)
    rw [List.getElem?_append_right (l₁ := trHead r destination)
      (i := r + 3 + i) (by rw [hhead]; omega)]
    rw [show r + 3 + i - (trHead r destination).length = i by
      rw [hhead]; omega]
    rw [List.getElem?_append_left
      (l₁ := List.replicate m (Instruction.inc .left))
      (i := i) (by rw [htail]; exact hi)]
    exact List.getElem?_replicate_of_lt hi
  simp [AssistantMachine.step, hget, AssistantMachine.readCounter,
    AssistantMachine.writeCounter, AssistantMachine.setPC]

/-- A run through any initial segment of the TR multiplication body. -/
theorem concreteTR_body_run
    (m r destination i fuel a b : Nat) (hbound : i + fuel ≤ m) :
    runN fuel (concreteTR m r destination)
      ⟨r + 3 + i, a, b⟩ =
      some ⟨r + 3 + i + fuel, a + fuel, b⟩ := by
  induction fuel generalizing i a b with
  | zero => simp [runN]
  | succ fuel ih =>
      have hi : i < m := by omega
      have hrest : (i + 1) + fuel ≤ m := by omega
      simp only [runN]
      rw [concreteTR_body_step m r destination i a b hi]
      simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
        ih (i + 1) (a + 1) b hrest

/-- The first instruction after the m-body is the identity-jump increment. -/
theorem concreteTR_close_inc
    (m r destination a b : Nat) :
    AssistantMachine.step (concreteTR m r destination)
      ⟨r + 3 + m, a, b⟩ =
      some ⟨r + 3 + m + 1, a + 1, b⟩ := by
  have hhead := trHead_length r destination
  have htail := trTail_replicate_length m
  have hget :
      (concreteTR m r destination)[r + 3 + m]? =
        some (Instruction.inc .left) := by
    change (trHead r destination ++
      (List.replicate m (Instruction.inc .left) ++
        [Instruction.inc .left, Instruction.decJump .left 0]))[r + 3 + m]? =
        some (Instruction.inc .left)
    rw [List.getElem?_append_right (l₁ := trHead r destination)
      (i := r + 3 + m) (by rw [hhead]; omega)]
    rw [show r + 3 + m - (trHead r destination).length = m by
      rw [hhead]; omega]
    rw [List.getElem?_append_right
      (l₁ := List.replicate m (Instruction.inc .left))
      (i := m) (by rw [htail])]
    simp
  simp [AssistantMachine.step, hget, AssistantMachine.readCounter,
    AssistantMachine.writeCounter, AssistantMachine.setPC]

/-- The second instruction after the m-body restores A and jumps to the loop header. -/
theorem concreteTR_close_jump
    (m r destination a b : Nat) :
    AssistantMachine.step (concreteTR m r destination)
      ⟨r + 3 + m + 1, a + 1, b⟩ =
      some ⟨0, a, b⟩ := by
  have hhead := trHead_length r destination
  have htail := trTail_replicate_length m
  have hget :
      (concreteTR m r destination)[r + 3 + m + 1]? =
        some (Instruction.decJump .left 0) := by
    change (trHead r destination ++
      (List.replicate m (Instruction.inc .left) ++
        [Instruction.inc .left, Instruction.decJump .left 0]))[r + 3 + m + 1]? =
        some (Instruction.decJump .left 0)
    rw [List.getElem?_append_right (l₁ := trHead r destination)
      (i := r + 3 + m + 1) (by rw [hhead]; omega)]
    rw [show r + 3 + m + 1 - (trHead r destination).length = m + 1 by
      rw [hhead]; omega]
    rw [List.getElem?_append_right
      (l₁ := List.replicate m (Instruction.inc .left))
      (i := m + 1) (by rw [htail]; omega)]
    rw [show m + 1 -
      (List.replicate m (Instruction.inc .left)).length = 1 by
        rw [htail]; omega]
    rfl
  simp [AssistantMachine.step, hget, AssistantMachine.readCounter,
    AssistantMachine.writeCounter, AssistantMachine.setPC]

/-- The two-instruction identity-jump tail returns to PC zero unchanged. -/
theorem concreteTR_close
    (m r destination a b : Nat) :
    runN 2 (concreteTR m r destination)
      ⟨r + 3 + m, a, b⟩ = some ⟨0, a, b⟩ := by
  simp [runN, concreteTR_close_inc, concreteTR_close_jump]

/-- One positive TR iteration consumes one unit of B and adds m to A. -/
theorem concreteTR_positive_round
    (m r destination a b : Nat) :
    runN (m + 3) (concreteTR m r destination)
      ⟨0, a, b + 1⟩ = some ⟨0, a + m, b⟩ := by
  have htest := concreteTR_positive_test m r destination a b
  have hbody :
      runN m (concreteTR m r destination)
        ⟨r + 3, a, b⟩ =
        some ⟨r + 3 + m, a + m, b⟩ := by
    simpa using concreteTR_body_run m r destination 0 m a b (by omega)
  have hclose := concreteTR_close m r destination (a + m) b
  calc
    runN (m + 3) (concreteTR m r destination) ⟨0, a, b + 1⟩ =
        (runN 1 (concreteTR m r destination) ⟨0, a, b + 1⟩).bind
          (fun middle => runN (m + 2) (concreteTR m r destination) middle) := by
            have hcount : m + 3 = 1 + (m + 2) := by omega
            rw [hcount]
            exact runN_add 1 (m + 2) _ _
    _ = runN (m + 2) (concreteTR m r destination) ⟨r + 3, a, b⟩ := by
          simp [runN, htest]
    _ = (runN m (concreteTR m r destination) ⟨r + 3, a, b⟩).bind
          (fun middle => runN 2 (concreteTR m r destination) middle) :=
            runN_add m 2 _ _
    _ = some ⟨0, a + m, b⟩ := by simp [hbody, hclose]

/-- The increment run in the zero-remainder handler. -/
theorem concreteTR_handler_step
    (m r destination i a b : Nat) (hi : i < r) :
    AssistantMachine.step (concreteTR m r destination)
      ⟨1 + i, a, b⟩ = some ⟨1 + i + 1, a + 1, b⟩ := by
  have hget :
      (concreteTR m r destination)[1 + i]? =
        some (Instruction.inc .left) := by
    change (trHead r destination ++ trTail m)[1 + i]? =
      some (Instruction.inc .left)
    rw [List.getElem?_append_left
      (l₁ := trHead r destination) (i := 1 + i) (by
        rw [trHead_length]; omega)]
    change ([Instruction.decJump .right (3 + r)] ++
      (List.replicate r (Instruction.inc .left) ++
        [Instruction.inc .left, Instruction.decJump .left destination]))[1 + i]? =
      some (Instruction.inc .left)
    rw [List.getElem?_append_right
      (l₁ := [Instruction.decJump .right (3 + r)]) (i := 1 + i) (by simp)]
    rw [show 1 + i - 1 = i by omega]
    rw [List.getElem?_append_left
      (l₁ := List.replicate r (Instruction.inc .left))
      (i := i) (by simpa using hi)]
    exact List.getElem?_replicate_of_lt hi
  simp [AssistantMachine.step, hget, AssistantMachine.readCounter,
    AssistantMachine.writeCounter, AssistantMachine.setPC]

/-- Execute all r remainder increments in the literal TR zero-branch handler. -/
theorem concreteTR_handler_run
    (m r destination i fuel a b : Nat) (hbound : i + fuel ≤ r) :
    runN fuel (concreteTR m r destination)
      ⟨1 + i, a, b⟩ =
      some ⟨1 + i + fuel, a + fuel, b⟩ := by
  induction fuel generalizing i a b with
  | zero => simp [runN]
  | succ fuel ih =>
      have hi : i < r := by omega
      have hrest : (i + 1) + fuel ≤ r := by omega
      simp only [runN]
      rw [concreteTR_handler_step m r destination i a b hi]
      simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
        ih (i + 1) (a + 1) b hrest

/-- The zero-remainder handler's first identity-jump instruction increments A. -/
theorem concreteTR_handler_close_inc
    (m r destination a b : Nat) :
    AssistantMachine.step (concreteTR m r destination)
      ⟨1 + r, a, b⟩ = some ⟨1 + r + 1, a + 1, b⟩ := by
  have hget :
      (concreteTR m r destination)[1 + r]? =
        some (Instruction.inc .left) := by
    change (trHead r destination ++ trTail m)[1 + r]? =
      some (Instruction.inc .left)
    rw [List.getElem?_append_left
      (l₁ := trHead r destination) (i := 1 + r) (by
        rw [trHead_length]; omega)]
    change ([Instruction.decJump .right (3 + r)] ++
      (List.replicate r (Instruction.inc .left) ++
        [Instruction.inc .left, Instruction.decJump .left destination]))[1 + r]? =
      some (Instruction.inc .left)
    rw [List.getElem?_append_right
      (l₁ := [Instruction.decJump .right (3 + r)]) (i := 1 + r) (by simp)]
    rw [show 1 + r - 1 = r by omega]
    rw [List.getElem?_append_right
      (l₁ := List.replicate r (Instruction.inc .left))
      (i := r) (by simp)]
    simp
  simp [AssistantMachine.step, hget, AssistantMachine.readCounter,
    AssistantMachine.writeCounter, AssistantMachine.setPC]

/-- The zero-remainder handler's second instruction jumps to the destination. -/
theorem concreteTR_handler_close_jump
    (m r destination a b : Nat) :
    AssistantMachine.step (concreteTR m r destination)
      ⟨1 + r + 1, a + 1, b⟩ = some ⟨destination, a, b⟩ := by
  have hget :
      (concreteTR m r destination)[1 + r + 1]? =
        some (Instruction.decJump .left destination) := by
    change (trHead r destination ++ trTail m)[1 + r + 1]? =
      some (Instruction.decJump .left destination)
    rw [List.getElem?_append_left
      (l₁ := trHead r destination) (i := 1 + r + 1) (by
        rw [trHead_length]; omega)]
    change ([Instruction.decJump .right (3 + r)] ++
      (List.replicate r (Instruction.inc .left) ++
        [Instruction.inc .left, Instruction.decJump .left destination]))[1 + r + 1]? =
      some (Instruction.decJump .left destination)
    rw [List.getElem?_append_right
      (l₁ := [Instruction.decJump .right (3 + r)]) (i := 1 + r + 1) (by simp)]
    rw [show 1 + r + 1 - 1 = r + 1 by omega]
    rw [List.getElem?_append_right
      (l₁ := List.replicate r (Instruction.inc .left))
      (i := r + 1) (by simp)]
    rw [show r + 1 - r = 1 by omega]
    rfl
  simp [AssistantMachine.step, hget, AssistantMachine.readCounter,
    AssistantMachine.writeCounter, AssistantMachine.setPC]

/-- The fixed remainder handler adds r and exits to the supplied destination. -/
theorem concreteTR_zero_exit
    (m r destination a : Nat) :
    runN (r + 3) (concreteTR m r destination)
      ⟨0, a, 0⟩ = some ⟨destination, a + r, 0⟩ := by
  have htest := concreteTR_zero_test m r destination a
  have hbody :
      runN r (concreteTR m r destination) ⟨1, a, 0⟩ =
        some ⟨1 + r, a + r, 0⟩ := by
    simpa using concreteTR_handler_run m r destination 0 r a 0 (by omega)
  have hclose :
      runN 2 (concreteTR m r destination) ⟨1 + r, a + r, 0⟩ =
        some ⟨destination, a + r, 0⟩ := by
    simp [runN, concreteTR_handler_close_inc,
      concreteTR_handler_close_jump]
  calc
    runN (r + 3) (concreteTR m r destination) ⟨0, a, 0⟩ =
        (runN 1 (concreteTR m r destination) ⟨0, a, 0⟩).bind
          (fun middle => runN (r + 2) (concreteTR m r destination) middle) := by
            have hcount : r + 3 = 1 + (r + 2) := by omega
            rw [hcount]
            exact runN_add 1 (r + 2) _ _
    _ = runN (r + 2) (concreteTR m r destination) ⟨1, a, 0⟩ := by
          simp [runN, htest]
    _ = (runN r (concreteTR m r destination) ⟨1, a, 0⟩).bind
          (fun middle => runN 2 (concreteTR m r destination) middle) :=
            runN_add r 2 _ _
    _ = some ⟨destination, a + r, 0⟩ := by simp [hbody, hclose]

/-- All-input exact primitive correctness of the literal emitted TR block. -/
theorem concreteTR_correct_run
    (m r destination a q : Nat) :
    runN (q * (m + 3) + r + 3) (concreteTR m r destination)
      ⟨0, a, q⟩ =
      some ⟨destination, a + m * q + r, 0⟩ := by
  induction q generalizing a with
  | zero =>
      simpa using concreteTR_zero_exit m r destination a
  | succ q ih =>
      have hround := concreteTR_positive_round m r destination a q
      have hrest := ih (a + m)
      have hcount :
          (q + 1) * (m + 3) + r + 3 =
            (m + 3) + (q * (m + 3) + r + 3) := by ring
      calc
        runN ((q + 1) * (m + 3) + r + 3)
            (concreteTR m r destination) ⟨0, a, q + 1⟩ =
          (runN (m + 3) (concreteTR m r destination)
              ⟨0, a, q + 1⟩).bind
            (fun middle => runN (q * (m + 3) + r + 3)
              (concreteTR m r destination) middle) := by
                rw [hcount]
                exact runN_add (m + 3) (q * (m + 3) + r + 3)
                  (concreteTR m r destination) ⟨0, a, q + 1⟩
        _ = runN (q * (m + 3) + r + 3)
              (concreteTR m r destination) ⟨0, a + m, q⟩ := by
                simp [hround]
        _ = some ⟨destination, a + m + m * q + r, 0⟩ := hrest
        _ = some ⟨destination, a + m * (q + 1) + r, 0⟩ := by
              congr 2 <;> ring

end Compiler
